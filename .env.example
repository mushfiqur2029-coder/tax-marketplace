# Copy this file to .env.local and fill in real values.

# ------- Supabase -------
# Project Settings → API Keys (new publishable/secret format).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# ------- Stripe -------
# Developers → API keys (test mode).
STRIPE_SECRET_KEY=sk_test_YOUR_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY
# Get this by running `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET

# ------- App -------
# Used to build Stripe success/cancel URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------- Google Calendar — first-party booking picker -------
# Service account auth for the Calendar + FreeBusy APIs, used by the
# in-app booking picker on the bespoke LC enquiry confirmation (and
# any future "pick a 15-minute slot" surface). The service account
# must be granted "Make changes to events" on GOOGLE_CALENDAR_ID.
#
# Supply the private key in ONE of two forms (base64 is preferred on
# Vercel because the CLI plugin rejects --value args that start with
# a dash, i.e. anything in PEM format):
#   GOOGLE_CALENDAR_PRIVATE_KEY_BASE64 = base64 of the full PEM
#   GOOGLE_CALENDAR_PRIVATE_KEY        = raw PEM, with literal \n
#                                        escape sequences
GOOGLE_CALENDAR_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_CALENDAR_PRIVATE_KEY_BASE64=LS0tLS1CRUdJTi...
# GOOGLE_CALENDAR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=you@example.com

# ------- Google OAuth2 (preferred: owner impersonation) -------
# When set, bookings go through the OAuth2 refresh token granted by
# the calendar owner at /api/auth/google/connect. Google then sends
# the native calendar invite + attaches a Meet link to events — things
# the service-account path above can't do on a personal (non-Workspace)
# calendar. Credentials come from a Google Cloud OAuth 2.0 Client ID
# (Web application type). Authorized redirect URIs on the Google side
# must include {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback for
# every environment you want to use consent on.
GOOGLE_OAUTH_CLIENT_ID=1234567890-xxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxx
# Optional. Defaults to {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback.
# Only set if your deployment needs a non-default redirect URI.
# GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/api/auth/google/callback

# ---------------------------------------------------------------------------
# SMTP — primary outbound mail path. Direct connection to the real
# Sterling Ledger mailbox so every email comes from the real "From".
# Port 465 is implicit TLS; set SMTP_SECURE=false and point at 587
# for STARTTLS. Password lives in Vercel as a sensitive env var.
SMTP_HOST=sterlingledger.co.uk
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@sterlingledger.co.uk
SMTP_PASSWORD=your-mailbox-password
